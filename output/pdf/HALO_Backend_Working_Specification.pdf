    },
    {
      "id": "BE-092",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 126,
      "end_line": 126,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "254e6b43aa511663ce6c00932e61789480ecf4c9fe4a28ef4b2d0dca201d5ce7",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Air",
        "Existing AirNow lookup with Open-Meteo model fallback",
        "Preserve measured versus modelled. Verify observation timestamps, reporting area, parameter coverage, licensing, and permitted forecast access before increasing polling. [AirNow documentation](https://docs.airnowapi.org/faq) describes variable forecast availability and category-only cases; do not manufacture numeric forecasts."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-092",
      "rendered_payload_length": 394,
      "rendered_payload_sha256": "254e6b43aa511663ce6c00932e61789480ecf4c9fe4a28ef4b2d0dca201d5ce7"
    },
    {
      "id": "BE-093",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 127,
      "end_line": 127,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "79db10cd16c79d8c7e08cbb0e2e509357bd2136396de9b05a254ebf91e4bd64e",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "UV and weather",
        "Existing Open-Meteo current UV and one-day hourly lookup; NWS hourly data; guarded OpenUV fallback",
        "Add issue time and valid time. Verify forecast horizon and uncertainty per provider. The [NWS API](https://www.weather.gov/documentation/services-web-api) supports weather forecasts, not an automatic seven-day forecast for every HALO factor."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-093",
      "rendered_payload_length": 363,
      "rendered_payload_sha256": "79db10cd16c79d8c7e08cbb0e2e509357bd2136396de9b05a254ebf91e4bd64e"
    },
    {
      "id": "BE-094",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 128,
      "end_line": 128,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "570bd95c335ab4602bec4eb714746de8df4ab613c89c4efa86f6b1985ac71874",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Pollen",
        "Existing Google Pollen request for one day",
        "Source S04 documents the one-to-five-day request range and current non-EEA retention exceptions: today's values 365 days, other forecast/heatmap values 24 hours. Verify account applicability, geography, attribution, quota, cost and exports/model/map rights. Preserve categories and retention classes separately; do not promise seven days."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-094",
      "rendered_payload_length": 396,
      "rendered_payload_sha256": "570bd95c335ab4602bec4eb714746de8df4ab613c89c4efa86f6b1985ac71874"
    },
    {
      "id": "BE-095",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 129,
      "end_line": 129,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "fc5ae822d0e535724b346ddd1c27724b8d5f76ed20b70d12162fd1109fc9aece",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Mold",
        "Existing proxy from NWS humidity and precipitation conditions",
        "Version and review the heuristic. It is not a measurement of outdoor spores or indoor mold. No background illustration or wording may imply detection."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-095",
      "rendered_payload_length": 225,
      "rendered_payload_sha256": "fc5ae822d0e535724b346ddd1c27724b8d5f76ed20b70d12162fd1109fc9aece"
    },
    {
      "id": "BE-096",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 130,
      "end_line": 130,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "f9542a4d7664d1d3d7b2704188b9f8a134e006af4ecb2d28c753a73cdf11cba2",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Utility water",
        "Existing UCMR utility data and geography",
        "Extend import records to retain tested analytes, non-detect qualifiers, dates, sampling context, and source releases where available. Verify current import coverage before claiming a denominator."
      ],
      "table_start": 124,
      "feature": null,
