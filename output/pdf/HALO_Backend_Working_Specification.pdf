      "rendered_payload_sha256": null
    },
    {
      "id": "AC-087",
      "source": "docs/product/HALO_FEATURE_ACCEPTANCE.md",
      "kind": "table_row",
      "start_line": 110,
      "end_line": 110,
      "headings": [
        "HALO Feature Preservation and Acceptance Plan",
        "Feature specific acceptance",
        "Entry and Today"
      ],
      "sha256": "03d035401fc07a3f1816ed65c9d78fac6f0b1ab00da835eed2d10d0d259d1fdc",
      "headers": [
        "Feature",
        "Required behavior and evidence of completion"
      ],
      "cells": [
        "G01 Onboarding",
        "Preserve approved layout and handwriting; support address, US ZIP and voluntary GPS without automatic permission requests; keep data on Back and failed save; confirm ambiguous writes using request identifiers; use authoritative completion state; distinguish out-of-region coverage from lookup failure; continue honestly when a provider cannot return a result. Test a new home, changed home, same address, skipped household, private well, spring, unknown year, offline interruption, timeout after successful write, and identity replacement."
      ],
      "table_start": 108,
      "feature": "G01",
      "disposition": "retained",
      "canonical_id": "AC-087",
      "rendered_payload_length": 618,
      "rendered_payload_sha256": "bab59e9817ef28aee28b86914724c443e705bd59c190b94787501079799dec5e"
    },
    {
      "id": "AC-088",
      "source": "docs/product/HALO_FEATURE_ACCEPTANCE.md",
      "kind": "table_row",
      "start_line": 111,
      "end_line": 111,
      "headings": [
        "HALO Feature Preservation and Acceptance Plan",
        "Feature specific acceptance",
        "Entry and Today"
      ],
      "sha256": "6b9416e0c4de0fbf75b06f77bccf9a0bf1e7f72bac6d5495d3264e6cbbd9fae0",
      "headers": [
        "Feature",
        "Required behavior and evidence of completion"
      ],
      "cells": [
        "T01 Today overview",
        "Four factors only, fixed card order, real source timestamps, explicit partial coverage, unknown distinct from zero, proper refresh cooldown, cached-reading notice, and meaningful change comparison using compatible time, coverage and methodology. A source arriving after an outage must not be described as worsening conditions. Ring and contributions must not claim percentages of health risk or formula weights when only visual input shares exist."
      ],
      "table_start": 108,
      "feature": "T01",
      "disposition": "retained",
      "canonical_id": "AC-088",
      "rendered_payload_length": 530,
      "rendered_payload_sha256": "e9c3f30a790f9121a6b7c8c488e26f08f5e537135bf1609553bd4249bbdb4d05"
    },
    {
      "id": "AC-089",
      "source": "docs/product/HALO_FEATURE_ACCEPTANCE.md",
      "kind": "table_row",
      "start_line": 112,
      "end_line": 112,
      "headings": [
        "HALO Feature Preservation and Acceptance Plan",
        "Feature specific acceptance",
        "Entry and Today"
      ],
      "sha256": "86ef07d941156711847847aa69253eec7563dab4418feb0c96cef824cd06ca54",
      "headers": [
        "Feature",
        "Required behavior and evidence of completion"
      ],
      "cells": [
        "T02 Air",
        "Show real AQI and dominant pollutant when provided, observation context, provenance, seven-day gaps, accessible chart data, and a link to the relevant monitor/map context. Save an applicable step into the shared action system and return to the same detail position. Unknown provenance is neither measured nor modelled."
      ],
      "table_start": 108,
      "feature": "T02",
      "disposition": "retained",
      "canonical_id": "AC-089",
      "rendered_payload_length": 390,
      "rendered_payload_sha256": "9cd17218a468ce8a0711d62a4f813ac39e3220c3094a6a5b68643244d137f744"
    },
    {
      "id": "AC-090",
      "source": "docs/product/HALO_FEATURE_ACCEPTANCE.md",
      "kind": "table_row",
      "start_line": 113,
      "end_line": 113,
      "headings": [
        "HALO Feature Preservation and Acceptance Plan",
        "Feature specific acceptance",
        "Entry and Today"
      ],
      "sha256": "2d6fe3b9dda66e732eb0932367cd6670a7415e82ab553c3cee567c3cf4282cf1",
      "headers": [
        "Feature",
        "Required behavior and evidence of completion"
      ],
      "cells": [
        "T03 UV",
        "Preserve rising-sun composition; distinguish observed/current reading, daily maximum and forecast window; include timezone and forecast issue time when supplied; allow inspecting a supported time and saving a chosen step. A null window must not imply low UV all day. Do not fill unavailable forecast hours with interpolated values."
      ],
      "table_start": 108,
      "feature": "T03",
      "disposition": "retained",
      "canonical_id": "AC-090",
      "rendered_payload_length": 402,
      "rendered_payload_sha256": "268af94b6e9dc7e61dbe8c06668cb1128075073828a68acdb5fd6d740d73b21b"
    },
    {
      "id": "AC-091",
      "source": "docs/product/HALO_FEATURE_ACCEPTANCE.md",
      "kind": "table_row",
      "start_line": 114,
      "end_line": 114,
      "headings": [
        "HALO Feature Preservation and Acceptance Plan",
        "Feature specific acceptance",
        "Entry and Today"
      ],
      "sha256": "f9f5aaa80853f68457e3a36ab63d92e962a294c677e37d0fcc1a1aa06ea7fe27",
      "headers": [
        "Feature",
        "Required behavior and evidence of completion"
      ],
      "cells": [
        "T04 Pollen",
        "Show tree, grass and weed separately with units or category definitions, source coverage and dominant category. Changing category updates its chart and accessible summary together. Seasonal text is reviewed and geographically appropriate, not a replacement for current data. Link to optional Journal without suggesting pollen caused a reported symptom."
      ],
