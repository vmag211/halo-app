    {
      "id": "BE-024",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 39,
      "end_line": 39,
      "headings": [
        "HALO Backend and Data Plan",
        "Existing backend baseline",
        "Current route inventory"
      ],
      "sha256": "1308543feae6fc63031485d6f4087020355913f1fde8329d7e3377068ed9df80",
      "headers": [
        "Existing route and methods",
        "Current inputs and response purpose",
        "Ownership and compatibility requirement"
      ],
      "cells": [
        "`/api/onboard` POST",
        "`address`, optional `water_source`, `home_year`, `request_id`; geocodes, matches service area, stores approximate location, returns location/utility and request marker, starts 28-day history backfill",
        "Session supplies owner; legacy `profile_id` must match. Preserve request-outcome reconciliation. Current `request_id` is a stored marker, not a full idempotency transaction."
      ],
      "table_start": 37,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-024",
      "rendered_payload_length": 401,
      "rendered_payload_sha256": "1308543feae6fc63031485d6f4087020355913f1fde8329d7e3377068ed9df80"
    },
    {
      "id": "BE-025",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 40,
      "end_line": 40,
      "headings": [
