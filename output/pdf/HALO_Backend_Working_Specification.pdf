      "rendered_payload_length": 258,
      "rendered_payload_sha256": "f9542a4d7664d1d3d7b2704188b9f8a134e006af4ecb2d28c753a73cdf11cba2"
    },
    {
      "id": "BE-097",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 131,
      "end_line": 131,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "27897346855d1f21fdef01920c4247aa146515bfc571b599d8e37a60eb015e86",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Radon and lead",
        "Existing county radon map, building-era lead estimate, utility inventory context",
        "Retain geography and estimate basis. Add household test evidence separately. Verify dataset versions and any source-specific limits."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-097",
      "rendered_payload_length": 236,
      "rendered_payload_sha256": "27897346855d1f21fdef01920c4247aa146515bfc571b599d8e37a60eb015e86"
    },
    {
      "id": "BE-098",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 132,
      "end_line": 132,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "e2a2bb35cdf599d46c0038332852d13650e1ecab55c2231bb042745f54d0de10",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Official alerts",
        "Existing NWS weather advisory parsing and stored water-result change detection",
        "Add authoritative utility or agency advisories only through a verified feed or reviewed publication workflow. A NWS warning is not a boil-water notice."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-098",
      "rendered_payload_length": 254,
      "rendered_payload_sha256": "e2a2bb35cdf599d46c0038332852d13650e1ecab55c2231bb042745f54d0de10"
    },
    {
      "id": "BE-099",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 133,
      "end_line": 133,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "279c4e332527fd72ea7fcc2324029af1c6504da3412548ffbf22c0d70179ab1a",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Fish advisories",
        "State health agency public ArcGIS records plus reviewed official documents",
        "October 3 samples verified two public services behind the [NC advisory landing page](https://epi.dph.ncdhhs.gov/oee/fish/arcg.html). A sampled row has truncated advice and an apparent audience/limit conflict. Use the exact endpoints and quarantine/review rules in source S13 of the acquisition guide. Complete text, extent, audience, effective status and reuse still require validation."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-099",
      "rendered_payload_length": 485,
      "rendered_payload_sha256": "279c4e332527fd72ea7fcc2324029af1c6504da3412548ffbf22c0d70179ab1a"
    },
    {
      "id": "BE-100",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 134,
      "end_line": 134,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "dc59979d6a96feaf44e855cf22ea1841d8f526e222be4ccb46923050a6dd3a85",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Food information",
        "Official food studies, openFDA food enforcement notices and reviewed local records",
        "Source S14 supplies a sampled openFDA recall API, including historical PFAS-related records. Keep lifecycle/product/lot scope. [FDA sampling publications](https://www.fda.gov/food/process-contaminants-food/testing-food-pfas-and-assessing-dietary-exposure) remain separate study imports, not a local-product safety API. Do not label unsampled nearby products or farms."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-100",
      "rendered_payload_length": 475,
