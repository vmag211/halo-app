    },
    {
      "id": "BE-101",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 135,
      "end_line": 135,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "167e293d35bc7922f771cd6d0069f367cd7d7ef71bb8ddc6a2241b6b9e10ec98",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Gardens and growers",
        "Proposed Extension, agriculture agency, certified testing, and conservation program resources",
        "[Routine NC soil testing](https://www.ncagr.gov/Divisions/Agronomic-Services/soil-testing) serves fertility needs, not automatic contaminant clearance. [NC drinking-water laboratory information](https://www.deq.nc.gov/about/divisions/water-resources/drinking-water/drinking-water-laboratories) requires checking certification scope. Store program eligibility and review dates. Guidance must specify when professional advice or testing is required."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-101",
      "rendered_payload_length": 569,
      "rendered_payload_sha256": "167e293d35bc7922f771cd6d0069f367cd7d7ef71bb8ddc6a2241b6b9e10ec98"
    },
    {
      "id": "BE-102",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 136,
      "end_line": 136,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "55456140cff70b58fbeaf8326436b9436a3cdccaf098689458542e3ea12d6423",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Environmental water samples",
        "Optional [Water Quality Portal services](https://www.waterqualitydata.us/webservices_documentation/)",
        "Services expose stations, results, and detection-limit information. Gate ingestion by parameter, matrix, method, location, and date. These are contextual environmental samples, not household tap or food clearance."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-102",
      "rendered_payload_length": 350,
      "rendered_payload_sha256": "55456140cff70b58fbeaf8326436b9436a3cdccaf098689458542e3ea12d6423"
    },
    {
      "id": "BE-103",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 137,
      "end_line": 137,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "c318f7b1bde5697d6a8723b2f750bd91b1fe62544083325e553f1dbfd5647791",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Water stewardship",
        "US Drought Monitor and the public service behind NC utility conservation status",
        "October 3 samples verified a categorical county drought response and the official NC map's conservation service. Sources S16 and S17 in the acquisition guide give exact endpoints and fields. Confirm reuse/cadence, utility ID crosswalk and full official restriction instructions; status alone cannot generate local watering rules."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-103",
      "rendered_payload_length": 435,
      "rendered_payload_sha256": "c318f7b1bde5697d6a8723b2f750bd91b1fe62544083325e553f1dbfd5647791"
    },
    {
      "id": "BE-104",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 138,
      "end_line": 138,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "3382216fb49b0830bf6e873b0c6d38d7c784c25f38c7f1f5f793973f788ad3d1",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Conservation",
        "Existing reviewed-organization structure; proposed organizer event pages and program feeds",
        "Verify organizers, service areas, source permission, event changes, and registration links. Begin with curated coverage rather than claiming universal listings."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-104",
      "rendered_payload_length": 272,
      "rendered_payload_sha256": "3382216fb49b0830bf6e873b0c6d38d7c784c25f38c7f1f5f793973f788ad3d1"
    },
    {
      "id": "BE-105",
      "source": "docs/product/HALO_BACKEND_AND_DATA_PLAN.md",
      "kind": "table_row",
      "start_line": 139,
      "end_line": 139,
      "headings": [
        "HALO Backend and Data Plan",
        "Source registry and acquisition gates"
      ],
      "sha256": "b89fbbdb49cbc4c38470477d644ee483db4366ad308b158ae0caac6d4fdff1ea",
      "headers": [
        "Domain",
        "Repository foundation or candidate source family",
        "Proposed acquisition and feasibility gate"
      ],
      "cells": [
        "Field observations",
        "Proposed private observations and official environmental reporting destinations",
        "[NC Stream Watch](https://www.deq.nc.gov/about/divisions/water-resources/water-resources-public-information/water-education-programs/water-education-and-outreach/nc-stream-watch) offers an official participation/reporting path; no submission API is established here. Verify the appropriate destination, jurisdiction, and form for each report. No agency receipt is assumed."
      ],
      "table_start": 124,
      "feature": null,
      "disposition": "retained",
      "canonical_id": "BE-105",
      "rendered_payload_length": 479,
      "rendered_payload_sha256": "b89fbbdb49cbc4c38470477d644ee483db4366ad308b158ae0caac6d4fdff1ea"
    },
