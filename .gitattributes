# Preserve approval evidence byte-for-byte across Windows/macOS/Linux checkouts.
/docs/onboarding/approved/** -text
/docs/onboarding/reference/** -text
/docs/foundation/approved/** -text
/docs/foundation/reference/** -text
# Keep upstream font-license text verbatim, including its original whitespace.
/public/fonts/*-OFL.txt -text -whitespace
# Preserve exported documents and recovery archives byte-for-byte on Windows.
*.pdf binary
*.tar.gz binary
*.zip binary
# Recorded public source downloads (B19 parser tests): byte-for-byte, so their sha256 matches the data file headers.
/test/fixtures/public-evidence/** -text -whitespace
