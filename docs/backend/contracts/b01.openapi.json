          "503": {
            "description": "Auth or feature unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Sent only when the 503 is the retryable auth outage (code auth_unavailable): 2 seconds. Not sent for feature_unavailable (a missing migration), which is not retryable. Rate-limit 429 responses do not send it."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 90
            },
            "description": "Validated even when from overrides it."
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive, at least 2000-01-01; explicit range at most 366 days."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive, defaults to today in America/New_York; at most tomorrow."
          },
          {
            "name": "context",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^([Aa][Ll][Ll])?$"
                },
                {
                  "type": "string",
                  "format": "uuid"
                }
              ]
            },
            "description": "Missing/empty selects current home plus unlinked rows. all is case-insensitive, one point per date/home. UUID requires ownership; unavailable before 0016."
          }
        ]
      }
    },
