  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "validation_failed",
              "auth_required",
              "auth_unavailable",
              "forbidden",
              "not_found",
              "conflict",
              "payload_too_large",
              "rate_limited",
              "upstream_unavailable",
              "internal_error",
              "feature_unavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{8,64}$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "stale_revision",
              "context_closed"
            ]
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "error",
          "code",
          "message",
          "field_errors",
          "retryable",
          "request_id"
        ],
        "additionalProperties": false
      },
      "ConflictEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorEnvelope"
          },
          {
            "properties": {
              "code": {
                "const": "conflict"
              },
              "retryable": {
                "const": false
              },
              "reason": {
                "enum": [
                  "stale_revision",
                  "context_closed"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "if": {
              "properties": {
                "reason": {
                  "const": "stale_revision"
                }
              }
            },
            "then": {
              "required": [
                "revision"
              ]
            }
          }
        ]
      },
      "HomeContext": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "origin": {
            "enum": [
              "onboard",
              "move",
              "legacy_migration"
            ]
          },
          "current": {
            "type": "boolean"
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -180,
                "maximum": 180
              },
              "county": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "lat",
              "lng",
              "county",
              "state"
            ],
            "additionalProperties": false
          },
          "pwsid": {
            "type": [
              "string",
              "null"
            ]
          },
          "service_area_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "water_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "utility",
              "well",
              "spring",
              "other",
              null
            ]
          },
          "home_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1700
          },
          "match_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "backfill": {
            "type": "object",
            "properties": {
              "state": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "not_started",
                  "running",
                  "complete",
                  "partial",
                  "failed",
                  "not_applicable",
                  null
