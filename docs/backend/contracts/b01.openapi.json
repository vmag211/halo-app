{
  "openapi": "3.1.0",
  "info": {
    "title": "HALO B01 backend contract",
    "version": "b01-1",
    "description": "Additive B01 surfaces. Errors use the shared envelope. Missing 0015 uses transactional:false; missing 0016 leaves onboard home_context:null and legacy history, while explicit home operations return feature_unavailable. This is not a capabilities endpoint or a claim of production verification. Only errors reachable by each handler are listed; shared schemas cover other routes too."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "bearerAuth": []
    }
  ],
