# Copy to .env.local for development. In Vercel these do not sync: set them there too, and redeploy
# after changing any of them. Mark keys, tokens and secrets as Sensitive in Vercel.

# Database and auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed if Supabase Auth enforces Turnstile CAPTCHA on anonymous sign-in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Data providers
AIRNOW_API_KEY=
GOOGLE_POLLEN_API_KEY=
MAPBOX_TOKEN=
OPENUV_API_KEY=

# Forecast (B10): the contact NWS asks for in the User-Agent of every api.weather.gov request.
# Server only, never NEXT_PUBLIC_. Unset, or left at this example.com placeholder: the forecast's Official notices
# row is unavailable and NWS is not called.
NWS_CONTACT=you@example.com

# Rate limits (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily job auth (/api/cron/daily)
CRON_SECRET=

# Device notifications (web push). Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Assistant and Luna (OpenRouter). ASSISTANT_MODEL_KEY falls back to OPENAI_API_KEY.
# Model ids have no default. Chat: a paid, non-reasoning model with paid fallbacks
# (live-checked 2026-10-20: openai/gpt-4.1-nano, about $0.0001 an answer); free chat
# models were down (404) or rate-limited upstream (429). The embedding model must be
# the one the corpus was ingested with, at ASSISTANT_EMBED_DIM (2048, migration 0013).
ASSISTANT_MODEL_KEY=
ASSISTANT_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
ASSISTANT_CHAT_MODEL=
ASSISTANT_CHAT_FALLBACK_MODELS=
ASSISTANT_EMBED_URL=https://openrouter.ai/api/v1/embeddings
ASSISTANT_EMBED_MODEL=
ASSISTANT_EMBED_DIM=2048
ASSISTANT_MIN_SIMILARITY=0.25
# Most tokens one answer may write (default 600, clamped to 64..4000)
ASSISTANT_CHAT_MAX_TOKENS=600
# App-wide questions per day (default 450)
ASSISTANT_GLOBAL_DAILY_LIMIT=450
# true sends readings and symptom names/dates to the model; free models may log prompts
ASSISTANT_SEND_HOUSEHOLD_CONTEXT=false

# Privacy review token (B07). Server only, at least 32 random characters: openssl rand -base64 48
# Unset or shorter: privacy requests are unavailable. Never reuse another key here
HALO_PRIVACY_REVIEW_KEY=
